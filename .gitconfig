[user]
	name = Grégoire Hébert
	email = gregoire@les-tilleuls.coop
	signingkey = /Users/gheb/.ssh/id_rsa.pub
[core]
	excludesfile = /Users/gheb/.gitignore_global
	ignorecase = false
	autocrlf = input
[difftool]
	prompt = false
[color]
	branch = auto
	status = auto
	interactive = auto
	diff = auto
[alias]
    # edit last commit
    amend = commit --amend
    
    # cancel last local commit
    undo = reset --soft HEAD^
    
    # rapid checkup
    changes = diff --name-status
    dic = diff --cached
    diffstat = diff --stat
    st = status -sb
    
    # condensed logs
    hist = log --pretty=oneline --abbrev-commit --graph --decorate
    
    # show changes since last pull
    lc = !git log --pretty=oneline ORIG_HEAD.. --stat --no-merges
    
    # add some files to commit
    addm = !git ls-files -m -z | xargs -0 git-add && git status
    addu = !git ls-files -o --exclude-standard -z | xargs -0 git-add && git status
    rmm = !git ls-files -d -z | xargs -0 git-rm && git status
    
    # show all users that did commit
    who = shortlog -sne
    supdate = submodule update --remote --merge
    spush = push --recurse-submodules=on-demand
    sdiff = !git diff && git submodule foreach 'git diff'

    #show logs of when something changed based on a string
    when = log -S -p

    ro = "!f() { git rebase --onto master $1 $2; }; f"
    fixup = commit --fixup
    ri = rebase -i --autosquash
    pr = pull --rebase

[commit]
	gpgsign = true
[gpg]
	program = gpg
	format = ssh
[rerere]
	enabled = true
[tag]
	sort = version:refname
[merge]
	tool = nvim
[init]
	defaultBranch = main
[diff]
	tool = nvim
	compactionHeuristic = 1
[pager]
	log = /opt/homebrew/share/git-core/contrib/diff-highlight/diff-highlight | less
	show = /opt/homebrew/share/git-core/contrib/diff-highlight/diff-highlight | less
	diff = /opt/homebrew/share/git-core/contrib/diff-highlight/diff-highlight | less
[interactive]
	diffFilter = /opt/homebrew/share/git-core/contrib/diff-highlight/diff-highlight
